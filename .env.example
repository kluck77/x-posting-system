# =============================================================================
# X Posting System - Environment Configuration
# =============================================================================
# INSTRUCTIONS FOR BEGINNERS:
# 1. Copy this file and rename the copy to ".env" (without "example")
# 2. Fill in your real keys below (replace the empty values after the = sign)
# 3. Never share your .env file with anyone!
# 4. Never upload .env to GitHub or any public place!
# =============================================================================

# =============================================================================
# AI PROVIDERS - 5 roles, each with a different job
# You do NOT need all keys. The system runs with zero keys (mock mode).
# Add keys one by one as you get them.
# =============================================================================

# --- ChatGPT / OpenAI  (Role: Draft Writer) ---
# Fast first-draft generation, rewriting, tone adjustment.
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Claude / Anthropic  (Role: Architect & Reviewer) ---
# Risk-aware review, final polish, safety checks.
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Gemini / Google  (Role: Research & Analysis) ---
# Comparison tables, long-form research, source summarization.
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Grok / xAI  (Role: Trend Hunter) ---
# X/Twitter real-time topic discovery. Trend input only — not fact authority.
# Get key from: https://console.x.ai/
GROK_API_KEY=

# --- Perplexity  (Role: Fact Checker & Source Finder) ---
# Citation helper, source verification.
# Get key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# =============================================================================
# ACTIVE PROVIDER SELECTION
# Which AI provider to use for each role.
# Options: "openai", "anthropic", "gemini", "grok", "perplexity", "mock"
# If left empty or set to "mock", the system uses built-in mock mode.
# =============================================================================

# Who writes the first draft?  (openai, anthropic, mock)
ACTIVE_DRAFT_PROVIDER=mock

# Who does research?  (gemini, perplexity, mock)
ACTIVE_RESEARCH_PROVIDER=mock

# Who hunts trends?  (grok, mock)
ACTIVE_TREND_PROVIDER=mock

# Who verifies facts / finds sources?  (perplexity, mock)
ACTIVE_FACTCHECK_PROVIDER=mock

# --- Naver Open API (뉴스 검색, 무료) ---
# 가입: https://developers.naver.com/apps/#/register → 뉴스 검색 권한 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# =============================================================================
# 속보 모니터 설정
# =============================================================================
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=1      # 1분 간격 (Naver API 일 25,000회 → 하루 7,200회 사용)
MONITOR_MAX_ALERTS_PER_RUN=3    # 한 사이클에 최대 3개 알림 (스팸 방지)

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# Create a bot: talk to @BotFather on Telegram, send /newbot
# Token looks like: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# Your chat ID (run: python scripts/get_telegram_chat_id.py)
TELEGRAM_CHAT_ID=

# =============================================================================
# X (TWITTER) API CREDENTIALS
# =============================================================================

# Get from: https://developer.x.com/en/portal/dashboard
# Need "Read and Write" permissions on your app.
#
# For POSTING you need all four below:
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# =============================================================================
# DATABASE
# =============================================================================

# SQLite — no setup needed. Just leave this as-is.
DATABASE_URL=sqlite:///./x_poster.db

# =============================================================================
# APP SETTINGS
# =============================================================================

DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO

# =============================================================================
# SAFETY
# =============================================================================

# Keep "false". ALL posts require your Telegram approval.
# Only "true" allows low-risk evergreen posts to skip approval (future).
ENABLE_AUTO_POST_LOW_RISK=false
