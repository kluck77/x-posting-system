# =============================================================================
# X Posting System - Environment Configuration
# =============================================================================
# INSTRUCTIONS FOR BEGINNERS:
# 1. Copy this file and rename the copy to ".env" (without "example")
# 2. Fill in your real keys below (replace the empty values after the = sign)
# 3. Never share your .env file with anyone!
# 4. Never upload .env to GitHub or any public place!
# =============================================================================

# =============================================================================
# AI PROVIDERS — 6 roles, 10 providers
# 키만 입력하면 자동으로 해당 역할에 활성화됩니다.
# 모든 키가 없어도 Mock 모드로 동작합니다.
#
# 월 $30 예산 최적 조합 (30 posts/day):
#   OPENAI_API_KEY     DraftWriter   ~$2/월
#   ANTHROPIC_API_KEY  Reviewer      ~$3/월
#   GEMINI_API_KEY     Researcher     무료
#   GROK_API_KEY       TrendHunter   ~$1/월
#   PERPLEXITY_API_KEY FactChecker   ~$2/월
#   TAVILY_API_KEY     WebSearcher    무료 (1000회/월)
#                                 합계 ~$8/월
# =============================================================================

# ── 기존 5개 프로바이더 ──────────────────────────────────────────────────────

# OpenAI ChatGPT  (Role: DraftWriter)
# 빠른 초안 생성. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude  (Role: Reviewer — 주역할)
# 리스크 판단 + 최종 다듬기. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini  (Role: Researcher)
# 배경 리서치 & 팩트 보강. 무료 1M tokens/day. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# xAI Grok  (Role: TrendHunter)
# X 실시간 트렌드 탐지. https://console.x.ai/
GROK_API_KEY=

# Perplexity  (Role: FactChecker)
# 팩트체크 & 출처 검증. https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── 신규 5개 프로바이더 — 키 입력 시 자동 활성화 ────────────────────────────

# DeepSeek  (Role: DraftWriter 대안 / Reviewer 대안)
# 강점: 한국어/아시아 컨텍스트 최강 + GPT 대비 10배 저렴 ($0.14/M tokens)
# deepseek-reasoner: 체인-오브-쏘트 분석 (Reviewer 역할 탁월)
# 발급: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq LPU  (Role: FastDraftWriter — 속보 전용)
# 강점: ~100ms 응답 (GPT 대비 20배 빠름) / 무료 티어: 30 req/min
# Llama 4 Scout / Llama 3.3 70B 모델 사용
# 발급: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily  (Role: WebSearcher — 신규 역할 #6)
# 강점: 속보 수신 즉시 최신 웹 컨텍스트 보강 → AI 초안 품질 향상
# 무료: 1,000회/월 / 이후 $4/1,000회
# 발급: https://app.tavily.com/
TAVILY_API_KEY=

# Mistral AI  (Role: Reviewer 대안)
# 강점: 유럽 AI — GDPR 완전 준수 / Claude 없을 때 최고의 대안 리뷰어
# 발급: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# Together AI  (Role: DraftWriter 대안)
# 강점: Meta Llama 3.1 405B 접근 / 오픈소스 최대 모델 / 민감 콘텐츠 유연
# Qwen 2.5 72B: 한/중/일 언어 특화
# 발급: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# =============================================================================
# ACTIVE PROVIDER SELECTION
# DraftWriter 역할만 수동 지정. 나머지는 키 보유 여부로 자동 선택.
# Options: openai | anthropic | deepseek | groq | together | mock
# =============================================================================

# 초안 작성 프로바이더 (비워두면 키 보유 순으로 자동 선택)
ACTIVE_DRAFT_PROVIDER=

# Reviewer는 anthropic → mistral → deepseek 순으로 자동 선택
# Researcher는 gemini → perplexity 순으로 자동 선택
# TrendHunter는 grok 자동 선택
# FactChecker는 perplexity 자동 선택
# WebSearcher는 tavily 자동 선택

# --- Naver Open API (뉴스 검색, 무료) ---
# 가입: https://developers.naver.com/apps/#/register → 뉴스 검색 권한 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# =============================================================================
# 속보 모니터 설정
# =============================================================================
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=1        # 1분 간격 (Naver API 일 25,000회 → 하루 7,200회 사용)
MONITOR_MAX_ALERTS_PER_RUN=3      # 한 사이클에 최대 3개 알림 (스팸 방지)
CROSS_VERIFY_MIN_SOURCES=4        # 속보 전송 전 최소 교차 확인 출처 수 (기본 4개)

# 모닝 다이제스트 (오후 10시~오전 5시 KST 수면 구간 뉴스 TOP 5)
DIGEST_ENABLED=true
DIGEST_HOUR_KST=5                 # 다이제스트 전송 시각 (KST), 기본 오전 5시
DIGEST_TOP_N=5                    # 다이제스트에 포함할 기사 수

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# Create a bot: talk to @BotFather on Telegram, send /newbot
# Token looks like: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# Your chat ID (run: python scripts/get_telegram_chat_id.py)
TELEGRAM_CHAT_ID=

# =============================================================================
# X (TWITTER) API CREDENTIALS
# =============================================================================

# Get from: https://developer.x.com/en/portal/dashboard
# Need "Read and Write" permissions on your app.
#
# For POSTING you need all four below:
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# =============================================================================
# DATABASE
# =============================================================================

# SQLite — no setup needed. Just leave this as-is.
DATABASE_URL=sqlite:///./x_poster.db

# =============================================================================
# APP SETTINGS
# =============================================================================

DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO

# =============================================================================
# SAFETY
# =============================================================================

# Keep "false". ALL posts require your Telegram approval.
# Only "true" allows low-risk evergreen posts to skip approval (future).
ENABLE_AUTO_POST_LOW_RISK=false
