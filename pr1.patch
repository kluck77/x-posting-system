+    "열애", "결별", "임신", "탈세", "열애설", "폭로글",
+    # 금융 미확인 주장
+    "파산", "부도", "디폴트",
+]
+
+# 커뮤니티 입력 시 HIGH를 강제하는 카테고리
+_COMMUNITY_ALWAYS_HIGH_CATEGORIES = {
