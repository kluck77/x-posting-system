+_COMMUNITY_HIGH_RISK_KEYWORDS = [
+    # 고발·폭로·법적 주장
+    "사기", "고소", "고발", "내부자", "폭로", "연루", "비리", "수사", "체포", "고소장",
+    "횡령", "배임", "불법",
